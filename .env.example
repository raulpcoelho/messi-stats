ENVIRONMENT=development
TYPEORM_CONNECTION=postgres
TYPEORM_HOST=localhost
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=docker
TYPEORM_DATABASE=pg-messi-stats
TYPEORM_PORT=5432
TYPEORM_ENTITIES=./dist/**/*.entity.js
TYPEORM_MIGRATIONS=./dist/database/migrations/*.js
TYPEORM_SEEDS=./dist/database/seeds/*.js
TYPEORM_MIGRATIONS_DIR=./src/database/migrations
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_POOL_SIZE=3

# Configure these on the deployed server to enable the hidden stats update.
# Keep the source URL and the update key out of public files.
API_MVSR_APP=
STATS_SYNC_TOKEN=
